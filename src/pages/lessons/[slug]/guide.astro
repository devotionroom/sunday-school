---
import { getCollection } from 'astro:content';
import LessonLayout from '../../../layouts/LessonLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(lesson => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content, headings } = await lesson.render();
---

<LessonLayout frontmatter={lesson.data} headings={headings}>
  <!-- Include a back to hub button at the very top of the guide -->
  <div slot="header" class="no-print hub-back-link">
    <div class="container">
      <a href={`${base}lessons/${lesson.slug}`}>&larr; Back to Lesson Hub</a>
    </div>
  </div>

  <!-- Save/Print prompt injected below the Big Idea in the lesson header -->
  <div slot="after-header" class="print-prompt">
    <a href={`${base}lessons/${lesson.slug}/guide/#print`} class="print-prompt-link">
      📄 Save as PDF / Print →
    </a>
  </div>

  <script>
    if (window.location.hash === '#print') {
      // Wait a brief moment for the page to finish rendering before printing
      setTimeout(() => window.print(), 500);
    }
  </script>

  <Content />
</LessonLayout>

<style>
  .hub-back-link {
    background: var(--color-bg-secondary);
    padding: 0.75rem 0;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
  }
  .hub-back-link a {
    color: var(--color-text-secondary);
  }
  .hub-back-link a:hover {
    color: var(--color-accent-primary);
  }
</style>
