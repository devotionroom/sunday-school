---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const activities = await getCollection('activities');
  return activities.map(activity => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await activity.render();
---

<Layout title={activity.data.title}>
  <div class="container">
    <div class="standalone-header no-print">
      <div class="breadcrumb">
        <a href={base}>&larr; Home</a> / Activities
      </div>
      <h1>{activity.data.title}</h1>
      <div class="tags">
        {activity.data.targetAges && activity.data.targetAges.map(age => <span class="tag">{age}</span>)}
        {activity.data.type && <span class="tag type-tag">{activity.data.type}</span>}
        {activity.data.time && <span class="tag time-tag">⏱ {activity.data.time}</span>}
      </div>
      <button class="btn btn-primary print-btn mt-4" onclick="window.print()">Print This Activity</button>
    </div>

    <!-- Print Header (Hidden on screen) -->
    <div class="print-only print-header">
      <h1>Activity: {activity.data.title}</h1>
      {(activity.data.type || activity.data.time) && (
        <p><strong>Type:</strong> {activity.data.type || 'Activity'} | <strong>Time:</strong> {activity.data.time || 'N/A'}</p>
      )}
      <hr />
    </div>

    {(activity.data.materials || activity.data.printables) && (
      <div class="activity-meta-card no-print">
        {activity.data.materials && (
          <div class="materials-list">
            <h3>Materials Needed</h3>
            <ul>
              {activity.data.materials.map(mat => <li>{mat}</li>)}
            </ul>
          </div>
        )}
        
        {activity.data.printables && (
          <div class="printables-list">
            <h3>Printables & Templates</h3>
            <div class="downloads">
              {activity.data.printables.map(file => (
                <a href={file.fileUrl} class="download-card" download target="_blank">
                  <div class="icon">📄</div>
                  <div class="details">
                    <strong>{file.title}</strong>
                    <span>Download PDF</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Print Materials (Visible only on print) -->
    {activity.data.materials && (
      <div class="print-only print-materials">
        <h3>Materials Needed:</h3>
        <ul>
          {activity.data.materials.map(mat => <li>{mat}</li>)}
        </ul>
      </div>
    )}

    <article class="prose activity-content" data-active-age="all">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .standalone-header {
    margin: 3rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .standalone-header h1 {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tag {
    background: var(--color-bg-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .type-tag {
    background: #e0f2fe;
    color: #0369a1;
  }

  .time-tag {
    background: #f1f5f9;
    color: #334155;
  }

  .mt-4 {
    margin-top: 1rem;
  }

  .activity-meta-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .activity-meta-card h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .materials-list ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .downloads {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.1s, border-color 0.1s;
  }

  .download-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .download-card .icon {
    font-size: 1.5rem;
  }

  .download-card .details {
    display: flex;
    flex-direction: column;
  }

  .download-card .details strong {
    font-size: 0.9rem;
  }

  .download-card .details span {
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .activity-content {
    margin-bottom: 4rem;
  }

  .print-only { display: none; }
  
  @media print {
    .print-only { display: block; margin-bottom: 2rem; }
    .print-header h1 { margin-top: 0; }
    .print-materials { margin-bottom: 2rem; }
    .print-materials h3 { margin-bottom: 0.5rem; }
  }
</style>
