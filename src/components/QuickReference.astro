---
interface Props {
  title: string;
  scripture: string;
  bigIdea: string;
  points: string[];
  activity: string;
  memoryVerse: string;
  takeHome: string;
}

const { title, scripture, bigIdea, points, activity, memoryVerse, takeHome } = Astro.props;
---

<div class="quick-reference no-print">
  <div class="qr-header">
    <h2>Teacher Quick Reference</h2>
    <span class="icon">⏱️</span>
  </div>
  
  <div class="qr-grid">
    <div class="qr-main">
      <div class="qr-item">
        <strong>Lesson:</strong> {title}
      </div>
      <div class="qr-item">
        <strong>Scripture:</strong> {scripture}
      </div>
      <div class="qr-item highlight">
        <strong>Big Idea:</strong> {bigIdea}
      </div>
    </div>
    
    <div class="qr-points">
      <strong>Three Main Points:</strong>
      <ol>
        {points.map(p => <li>{p}</li>)}
      </ol>
    </div>
    
    <div class="qr-actions">
      <div class="qr-item"><strong>Activity:</strong> {activity}</div>
      <div class="qr-item"><strong>Memory Verse:</strong> {memoryVerse}</div>
      <div class="qr-item take-home">
        <strong>Take-Home Truth:</strong><br/>
        <em>"{takeHome}"</em>
      </div>
    </div>
  </div>
</div>

<style>
  .quick-reference {
    background: var(--color-surface);
    border: 2px solid var(--color-accent-primary);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 2rem 0 3rem 0;
    box-shadow: var(--shadow-md);
  }
  
  .qr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
  }
  
  .qr-header h2 {
    margin: 0;
    font-size: 1.5rem;
    border: none;
    padding: 0;
  }
  
  .icon {
    font-size: 1.5rem;
  }

  .qr-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  /* Prevent grid children from overflowing their track */
  .qr-main,
  .qr-points,
  .qr-actions {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .qr-grid {
      grid-template-columns: 1fr 1fr;
    }
    .qr-actions {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      border-top: 1px solid var(--color-border);
      padding-top: 1rem;
    }
  }

  .qr-item {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  
  .qr-item.highlight {
    background: var(--color-bg-secondary);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--color-accent-warm);
    margin-top: 0.5rem;
  }

  .qr-points ol {
    margin: 0.5rem 0 0 0;
    padding-left: 1.25rem;
  }
  
  .qr-points li {
    margin-bottom: 0.25rem;
  }

  .take-home {
    background: #F0FDF4; /* Very light green */
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid #BBF7D0;
    color: #166534;
  }
</style>
