---
<div class="age-selector no-print">
  <span class="label">Filter Content:</span>
  <div class="buttons">
    <button class="age-btn active" data-target-age="all">All Ages</button>
    <button class="age-btn" data-target-age="preschool">Preschool</button>
    <button class="age-btn" data-target-age="elementary">Early Elementary</button>
    <button class="age-btn" data-target-age="upper-elementary">Upper Elementary</button>
  </div>
</div>

<script>
  // Simple client-side script to toggle the data attribute on the article
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.age-btn');
    const lessonContainer = document.getElementById('lesson-content');

    if (!lessonContainer) return;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active button state
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Update the global data attribute which drives the CSS display:none logic
        const targetAge = btn.getAttribute('data-target-age');
        if (targetAge) {
          lessonContainer.setAttribute('data-active-age', targetAge);
        }
      });
    });
  });
</script>

<style>
  .age-selector {
    background: var(--color-surface);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .age-selector {
      flex-direction: row;
      align-items: center;
    }
  }
  .label {
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-right: 1rem;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .age-btn {
    background: var(--color-bg-secondary);
    border: 1px solid transparent;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-lg);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--color-text-primary);
  }
  .age-btn:hover {
    background: var(--color-border);
  }
  .age-btn.active {
    background: var(--color-accent-primary);
    color: white;
    font-weight: 600;
  }
</style>
