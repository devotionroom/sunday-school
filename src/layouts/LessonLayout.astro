---
import Layout from './Layout.astro';
import AgeSelector from '../components/AgeSelector.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  frontmatter: any;
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
---

<Layout title={frontmatter.title}>
  <div class="lesson-header no-print">
    <div class="container">
      <h1>{frontmatter.title}</h1>
      {frontmatter.bibleReference && <div class="bible-ref">📖 {frontmatter.bibleReference}</div>}
      {frontmatter.bigIdea && <p class="big-idea">💡 <strong>Big Idea:</strong> {frontmatter.bigIdea}</p>}
    </div>
  </div>

  <div class="container lesson-grid">
    <aside class="sidebar">
      <TableOfContents headings={headings} />
    </aside>
    
    <div class="main-content">
      <AgeSelector />
      
      <!-- Print Header (Hidden on screen) -->
      <div class="print-only print-header">
        <h1>{frontmatter.title}</h1>
        <p><strong>Reference:</strong> {frontmatter.bibleReference}</p>
        <p><strong>Big Idea:</strong> {frontmatter.bigIdea}</p>
        <hr />
      </div>

      <!-- Article container with the data attribute for age filtering -->
      <article id="lesson-content" data-active-age="all" class="prose">
        <slot />
      </article>
    </div>
  </div>
</Layout>

<style>
  .lesson-header {
    background: var(--color-surface);
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }
  .lesson-header h1 {
    margin: 0 0 1rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .bible-ref {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent-primary);
    margin-bottom: 1rem;
  }
  .big-idea {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .lesson-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 900px) {
    .lesson-grid {
      grid-template-columns: 250px 1fr;
      align-items: start;
    }
  }

  .prose {
    max-width: 800px;
  }
  
  .print-only {
    display: none;
  }

  @media print {
    .sidebar { display: none; }
    .lesson-grid { display: block; }
    .print-only { display: block; margin-bottom: 2rem; }
    .print-header h1 { margin-top: 0; }
  }

  /* --- Age Filter Logic --- */
  article[data-active-age="preschool"] :global(.age-elementary),
  article[data-active-age="preschool"] :global(.age-upper-elementary) {
    display: none !important;
  }
  
  article[data-active-age="elementary"] :global(.age-preschool),
  article[data-active-age="elementary"] :global(.age-upper-elementary) {
    display: none !important;
  }
  
  article[data-active-age="upper-elementary"] :global(.age-preschool),
  article[data-active-age="upper-elementary"] :global(.age-elementary) {
    display: none !important;
  }
</style>

